{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-film-pipeline/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Every stage reads this file; nothing about the film is hidden in code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "logline", "audience", "intent", "language", "format", "style_block", "characters", "voice", "shots", "music_cues", "end_card"],
  "properties": {
    "version": { "const": 1 },
    "notes": { "type": "string", "description": "Free text for humans. Ignored by the pipeline." },
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string", "minLength": 1, "description": "One sentence that sums up the story." },
    "audience": { "type": "string", "minLength": 1, "description": "Who watches, and where (see DESIGN.md)." },
    "intent": { "type": "string", "minLength": 1, "description": "What the audience should feel or understand at the end." },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration", "subtitles"],
      "properties": {
        "narration": { "type": "string", "pattern": "^[a-z]{2,3}$", "description": "ISO 639 code, e.g. am, om, ti, so, en" },
        "subtitles": { "type": "string", "pattern": "^[a-z]{2,3}$" }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratios", "fps"],
      "properties": {
        "aspect_ratios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["9:16", "16:9"] }
        },
        "fps": { "type": "integer", "minimum": 12, "maximum": 60 }
      }
    },
    "style_block": {
      "type": "string",
      "minLength": 1,
      "description": "Fixed look description appended to every image prompt (palette, light, medium). Describe qualities, not living artists."
    },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "voice_name", "style", "style_mode"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "voice_name": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "description": "Default delivery instruction for every line, e.g. calm, warm, unhurried. Never spoken." },
        "style_mode": {
          "enum": ["speech_metadata", "prompt_prefix", "none"],
          "description": "How style reaches the TTS model: the SDK's speech_metadata field, a text prefix, or not at all."
        },
        "language_code": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "description": "Passed to TTS, e.g. am or am-ET." },
        "mode": {
          "enum": ["per_line", "continuous"],
          "default": "per_line",
          "description": "per_line: one TTS call per shot (cheap single-line retakes). continuous: the whole narration in ONE call (one voice and flow throughout), split at pauses into per-shot segments. Per-line style overrides are ignored in continuous mode."
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shot" }
    },
    "music_cues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/music_cue" }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "duration_s"],
      "properties": {
        "text": { "type": "string", "pattern": "\\b(AI|Ai|ai)\\b", "description": "Must say the film was made with AI." },
        "duration_s": { "type": "number", "minimum": 2, "maximum": 5 }
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "consent_ref"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1, "description": "Same wording every time, so the look does not drift." },
        "reference_image": { "type": ["string", "null"], "description": "Path to the approved reference sheet image, once generated." },
        "consent_ref": { "type": "string", "minLength": 1, "description": "Where consent is recorded, e.g. ETHICS.md#grandmother, or 'fictional' for an invented person." }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "duration_s", "reason", "shot_size", "characters", "image_prompt", "motion_prompt", "seed", "narration", "video"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]{2}$" },
        "duration_s": { "type": "number", "minimum": 2, "maximum": 15 },
        "reason": { "type": "string", "minLength": 1, "description": "Why this shot exists, in one sentence." },
        "shot_size": { "enum": ["extreme_wide", "wide", "medium", "medium_close_up", "close_up", "extreme_close_up", "insert"] },
        "characters": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "image_prompt": { "type": "string", "minLength": 1 },
        "motion_prompt": { "type": "string", "minLength": 1, "description": "Only motion and camera; the keyframe already holds the subject." },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "subtitle_en"],
          "properties": {
            "text": { "type": "string", "description": "ONLY the words to be spoken, in the film's language. No stage directions. Empty string = silent shot." },
            "subtitle_en": { "type": "string" },
            "speech_metadata": { "$ref": "#/$defs/speech_metadata" }
          }
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "fallback"],
          "properties": {
            "method": { "enum": ["wan_i2v", "hunyuan_i2v", "ken_burns", "still"] },
            "fallback": { "enum": ["ken_burns", "still"] }
          }
        }
      }
    },
    "speech_metadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Delivery and timing cues, kept apart from the spoken text.",
      "properties": {
        "style": { "type": "string", "minLength": 1, "description": "Overrides voice.style for this line. Affects the audio (part of the narration hash)." },
        "pause_before_s": { "type": "number", "minimum": 0, "maximum": 3, "description": "Silence before the line starts. Edit-only: no new TTS call." },
        "pause_after_s": { "type": "number", "minimum": 0, "maximum": 5, "description": "Minimum silence after the line. Edit-only: no new TTS call." }
      }
    },
    "music_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_s", "end_s", "caption"],
      "properties": {
        "id": { "type": "string", "pattern": "^m[0-9]+$" },
        "start_s": { "type": "number", "minimum": 0 },
        "end_s": { "type": "number", "exclusiveMinimum": 0 },
        "caption": { "type": "string", "minLength": 1, "description": "Style, mood, instruments, texture. Tempo and key go in their own fields." },
        "instrumental": { "type": "boolean", "default": true },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
        "key": { "type": "string" }
      }
    }
  }
}
