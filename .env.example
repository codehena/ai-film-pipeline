# Copy this file to .env and put your real keys there.
# .env is git-ignored. NEVER put real keys in this file.

# Google AI Studio -> Get API key (script, translation, narration TTS)
GEMINI_API_KEY=your-gemini-key-here

# Cloudflare dashboard -> Workers AI (keyframes)
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_API_TOKEN=your-token-here

# Kaggle -> Settings -> API (GPU notebooks for Wan 2.2 and ACE-Step)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key-here
